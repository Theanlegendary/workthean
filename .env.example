# Environment Variables Configuration
PORT=5000
NODE_ENV=production

# Live AI API Keys (Optional - Fallback Engine Active by Default)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Cloud Database Configuration (Optional for Supabase / PostgreSQL)
DATABASE_URL=postgres://postgres:password@db.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JWT Secret Key
JWT_SECRET=super_secret_jwt_token_key_2026
